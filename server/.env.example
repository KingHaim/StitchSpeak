# ── Required ─────────────────────────────────────────────

# Google AI / Gemini API key (server-side only — never exposed to the browser)
GEMINI_API_KEY=

# Google OAuth Web client ID (same value as VITE_GOOGLE_CLIENT_ID in the root .env)
# Used server-side to cryptographically verify Google ID tokens
GOOGLE_CLIENT_ID=

# ── Optional ─────────────────────────────────────────────

# Port the Express server listens on (default: 3001)
# PORT=3001

# Comma-separated frontend origins allowed by CORS
# (localhost:5173 and localhost:4173 are always allowed)
# FRONTEND_URL=https://stitchspeak.example.com

# Directory for persistent data (SQLite credits DB)
# Defaults to ./data relative to the server working directory
# DATA_DIR=./data
