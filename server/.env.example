# ── Required ─────────────────────────────────────────────

# Google AI / Gemini API key (server-side only — never exposed to the browser)
GEMINI_API_KEY=

# OpenAI API key for assisted tech editing (server-side only)
OPENAI_API_KEY=

# Google OAuth Web client ID (same value as VITE_GOOGLE_CLIENT_ID in the root .env)
# Used server-side to cryptographically verify Google ID tokens
GOOGLE_CLIENT_ID=

# Long random value used to sign first-party email/password sessions.
# Generate one with: openssl rand -base64 48
AUTH_SESSION_SECRET=

# Canonical frontend URL used in verification and password-reset links
APP_URL=https://stitchspeak.com

# Transactional email delivery for account verification and recovery
RESEND_API_KEY=
AUTH_EMAIL_FROM=StitchSpeak <account@your-verified-domain.example>

# ── Payments (Lemon Squeezy) ─────────────────────────────
# Required for buying credits. Without these, /api/credits/checkout returns 503
# and the Buy Credits button is disabled. Credits are ONLY granted by the
# signature-verified webhook after Lemon Squeezy confirms payment.

# Lemon Squeezy API key from Settings → API
LEMON_SQUEEZY_API_KEY=

# Lemon Squeezy store ID from Settings → Stores
LEMON_SQUEEZY_STORE_ID=

# Lemon Squeezy variant ID for the StitchSpeak credits product.
# The server overrides the checkout price per pack using custom_price.
LEMON_SQUEEZY_VARIANT_ID=

# Signing secret for POST /api/lemon-squeezy/webhook.
# You choose this value when creating the webhook in Lemon Squeezy.
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────

# Set to "production" to suppress internal error details in API responses
# NODE_ENV=production

# Port the Express server listens on (default: 3001)
# PORT=3001

# Comma-separated frontend origins allowed by CORS
# (localhost:5173 and localhost:4173 are always allowed)
# FRONTEND_URL=https://stitchspeak.example.com

# Directory for persistent data (SQLite credits DB)
# Defaults to ./data relative to the server working directory
# DATA_DIR=./data

# Where in-app tester feedback emails are delivered (comma-separated).
# Defaults to ADMIN_EMAILS when unset. Requires RESEND_API_KEY + AUTH_EMAIL_FROM.
# FEEDBACK_EMAIL_TO=you@example.com

# ── PostHog server access (optional) ─────────────────────
# Lets the server pull a user's recent activity (pages visited, actions taken)
# into feedback emails and the admin member panel. Create a personal API key
# (phx_...) in PostHog → Settings → Personal API keys with read access to the
# project, and copy the numeric project id from the project settings URL.
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_PROJECT_ID=12345
# POSTHOG_API_HOST=https://us.posthog.com

# How many days of per-user credit movements (charges, refunds, purchases,
# admin adjustments) to keep for dispute resolution. Default 365 — comfortably
# past the ~120-day card chargeback window. Older rows are pruned automatically.
# CREDIT_LEDGER_RETENTION_DAYS=365

# ── Encrypted offsite backups (recommended in production) ──────────────
# Works with AWS S3, Cloudflare R2, Backblaze B2, and other S3-compatible stores.
# Generate the encryption key once with: openssl rand -base64 32
# Keep that key outside Railway too; backups cannot be restored without it.
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=stitchspeak-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_KEY=
# BACKUP_S3_PREFIX=production
# BACKUP_S3_FORCE_PATH_STYLE=false
