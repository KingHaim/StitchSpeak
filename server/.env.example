# ── Required ─────────────────────────────────────────────

# Google AI / Gemini API key (server-side only — never exposed to the browser)
GEMINI_API_KEY=

# Google OAuth Web client ID (same value as VITE_GOOGLE_CLIENT_ID in the root .env)
# Used server-side to cryptographically verify Google ID tokens
GOOGLE_CLIENT_ID=

# Long random value used to sign first-party email/password sessions.
# Generate one with: openssl rand -base64 48
AUTH_SESSION_SECRET=

# ── Payments (Lemon Squeezy) ─────────────────────────────
# Required for buying credits. Without these, /api/credits/checkout returns 503
# and the Buy Credits button is disabled. Credits are ONLY granted by the
# signature-verified webhook after Lemon Squeezy confirms payment.

# Lemon Squeezy API key from Settings → API
LEMON_SQUEEZY_API_KEY=

# Lemon Squeezy store ID from Settings → Stores
LEMON_SQUEEZY_STORE_ID=

# Lemon Squeezy variant ID for the StitchSpeak credits product.
# The server overrides the checkout price per pack using custom_price.
LEMON_SQUEEZY_VARIANT_ID=

# Signing secret for POST /api/lemon-squeezy/webhook.
# You choose this value when creating the webhook in Lemon Squeezy.
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────

# Set to "production" to suppress internal error details in API responses
# NODE_ENV=production

# Port the Express server listens on (default: 3001)
# PORT=3001

# Comma-separated frontend origins allowed by CORS
# (localhost:5173 and localhost:4173 are always allowed)
# FRONTEND_URL=https://stitchspeak.example.com

# Directory for persistent data (SQLite credits DB)
# Defaults to ./data relative to the server working directory
# DATA_DIR=./data
