# ── Required ─────────────────────────────────────────────

# Google OAuth Web client ID (enables Google Sign-In button)
VITE_GOOGLE_CLIENT_ID=

# ── Optional ─────────────────────────────────────────────

# Backend origin the frontend calls for translation, chat, glossary, credits
# In dev, Vite proxies /api/* to this URL automatically
# In production, set this to your server's public URL
# Omit to use same-origin (works behind a shared reverse proxy)
# VITE_API_URL=http://localhost:3001
