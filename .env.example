# ── Required ─────────────────────────────────────────────

# Google OAuth Web client ID (enables Google Sign-In button)
VITE_GOOGLE_CLIENT_ID=

# ── Optional ─────────────────────────────────────────────

# Backend origin for translation, chat, glossary, credits
# In Vite dev the browser always uses same-origin `/api/*`; this value is only
# the proxy target (and is used as the absolute API origin in production builds).
# Prefer http://localhost:3001 when running the Express server locally.
# Omit in production to use same-origin (shared reverse proxy).
# VITE_API_URL=http://localhost:3001

# PostHog project API key (public). When set, each signed-in user (tester) is
# identified by id/email/name in PostHog session recordings and events.
# Omit to disable analytics entirely (e.g. local dev).
# The production project lives in the EU region, so the host must be
# https://eu.i.posthog.com (defaults to https://us.i.posthog.com when unset).
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
